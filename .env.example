# Copy this file to .env and replace the placeholder. Never commit .env.
# Use a dedicated database account with SELECT-only access (see README.md).
DATABASE_URL=postgresql://codex_mcp:replace-with-a-strong-password@127.0.0.1:5432/your_database

# Keep the server limited to these schemas. Comma-separated.
ALLOWED_SCHEMAS=public

# Optional: restrict the table tools even further, e.g. public.orders,public.customers.
# When this is set, custom SQL is disabled so it cannot bypass this allow-list.
ALLOWED_TABLES=

# Guardrails for data volume and slow queries.
DEFAULT_ROW_LIMIT=100
MAX_ROW_LIMIT=500
STATEMENT_TIMEOUT_MS=10000

# Set to require only if your PostgreSQL service requires TLS.
DB_SSL_MODE=disable
# Set false only when using a trusted local or private CA that cannot be verified.
DB_SSL_REJECT_UNAUTHORIZED=true
